{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && (data.child('meta/activeAt').exists() ? data.child('meta/activeAt').val() < now - 604800000 : data.child('meta/createdAt').val() < now - 604800000)",
        ".validate": "$code.matches(/^[0-9]{6}$/)",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() == auth.uid)",
          ".validate": "newData.hasChildren(['v', 'host', 'createdAt', 'state', 'i'])",
          "v": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000" },
          "host": {
            ".write": "auth != null && newData.val() == auth.uid && data.parent().parent().child('players').child(auth.uid).exists() && data.parent().parent().child('players').child(data.val() + '').child('online').val() != true",
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "createdAt": { ".validate": "newData.val() == now || newData.val() == data.val()" },
          "activeAt": { ".validate": "newData.val() == now || newData.val() == data.val()" },
          "state": { ".validate": "newData.isString() && newData.val().matches(/^(lobby|answering|reveal|done)$/)" },
          "i": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100" },
          "steps": {
            "$k": { ".validate": "$k.matches(/^[0-3]$/) && newData.isString() && newData.val().matches(/^(start|rec|ar|serve)$/)" }
          },
          "order": { ".validate": "newData.isString() && newData.val().matches(/^(order|mixed)$/)" },
          "vis": { ".validate": "newData.isString() && newData.val().matches(/^(none|ref|all)$/)" },
          "nb": { ".validate": "newData.isBoolean()" },
          "sets": { ".validate": "newData.isBoolean()" },
          "rulesMode": { ".validate": "newData.isString() && newData.val().matches(/^(simple|official|drill)$/)" },
          "queue": {
            "$k": {
              ".validate": "$k.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['ri', 'phase'])",
              "ri": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
              "phase": { ".validate": "newData.isString() && newData.val().matches(/^(start|rec|ar|serve)$/)" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "$uid.length <= 40 && newData.parent().parent().child('meta').exists() && newData.hasChildren(['name', 'role', 'color', 'joinedAt']) && (data.exists() || newData.hasChild('v'))",
            "v": { ".validate": "newData.val() == newData.parent().parent().parent().child('meta/v').val()" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "role": { ".validate": "newData.isString() && newData.val().matches(/^(MB|MB1|MB2|OH1|OH2|OP|S|L)$/)" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
            "joinedAt": { ".validate": "newData.val() == now || newData.val() == data.val()" },
            "online": { ".validate": "newData.isBoolean()" },
            "score": { ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid", ".validate": "newData.isNumber()" },
            "streak": { ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid", ".validate": "newData.isNumber()" },
            "perfect": { ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid", ".validate": "newData.isNumber()" },
            "close": { ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid", ".validate": "newData.isNumber()" },
            "helps": { ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid", ".validate": "newData.isNumber()" },
            "nbOk": { ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid", ".validate": "newData.isNumber()" },
            "nbN": { ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid", ".validate": "newData.isNumber()" },
            "setOk": { ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid", ".validate": "newData.isNumber()" },
            "setN": { ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid", ".validate": "newData.isNumber()" },
            "misses": {
              ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid",
              "$k": {
                ".validate": "$k.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['ri', 'phase'])",
                "ri": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
                "phase": { ".validate": "newData.isString() && newData.val().matches(/^(start|rec|ar|serve)$/)" },
                "$other": { ".validate": false }
              }
            },
            "results": {
              ".write": "auth != null && !newData.exists() && data.parent().parent().parent().child('meta/host').val() == auth.uid",
              "$k": {
                ".validate": "$k.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['q', 'pts'])",
                "q": { ".validate": "newData.isString() && newData.val().matches(/^(perfect|close|miss)$/)" },
                "pts": { ".validate": "newData.isNumber()" },
                "nb": {
                  "pick": { ".validate": "newData.isString() && newData.val().length <= 3" },
                  "a": { ".validate": "newData.isString() && newData.val().length <= 3" },
                  "ok": { ".validate": "newData.isBoolean()" },
                  "$other": { ".validate": false }
                },
                "set": {
                  "ask": { ".validate": "newData.isString() && newData.val().length <= 8" },
                  "pick": { ".validate": "newData.isString() && newData.val().length <= 8" },
                  "ok": { ".validate": "newData.isBoolean()" },
                  "$other": { ".validate": false }
                },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "answers": {
          ".write": "auth != null && !newData.exists() && data.parent().child('meta/host').val() == auth.uid",
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/)",
            "$uid": {
              ".write": "auth != null && auth.uid == $uid",
              ".validate": "newData.hasChildren(['q', 'pts', 'done'])",
              "tap": {
                "x": { ".validate": "newData.isNumber()" },
                "y": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              },
              "off": { ".validate": "newData.isBoolean()" },
              "q": { ".validate": "newData.isString() && newData.val().matches(/^(perfect|close|miss)$/)" },
              "pts": { ".validate": "newData.isNumber()" },
              "bd": {
                "base": { ".validate": "newData.isNumber()" },
                "speed": { ".validate": "newData.isNumber()" },
                "streak": { ".validate": "newData.isNumber()" },
                "mult": { ".validate": "newData.isNumber()" },
                "nb": { ".validate": "newData.isNumber()" },
                "set": { ".validate": "newData.isNumber()" },
                "$other": { ".validate": false }
              },
              "nb": {
                "pick": { ".validate": "newData.isString() && newData.val().length <= 3" },
                "a": { ".validate": "newData.isString() && newData.val().length <= 3" },
                "ok": { ".validate": "newData.isBoolean()" },
                "$other": { ".validate": false }
              },
              "set": {
                "ask": { ".validate": "newData.isString() && newData.val().length <= 8" },
                "pick": { ".validate": "newData.isString() && newData.val().length <= 8" },
                "ok": { ".validate": "newData.isBoolean()" },
                "$other": { ".validate": false }
              },
              "done": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "reports": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "$id.matches(/^[-_A-Za-z0-9]{20}$/) && newData.hasChildren(['comment', 'createdAt', 'tab', 'role', 'rules', 'view', 'theme', 'viewport', 'ua', 'version', 'flags'])",
        "comment": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1000" },
        "createdAt": { ".validate": "newData.val() == now" },
        "tab": { ".validate": "newData.isString() && newData.val().matches(/^(learn|drill|game|sets|none)$/)" },
        "role": { ".validate": "newData.isString() && newData.val().matches(/^(MB|MB1|MB2|OH1|OH2|OP|S|L)$/)" },
        "rules": { ".validate": "newData.isString() && newData.val().matches(/^(simple|official)$/)" },
        "view": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "theme": { ".validate": "newData.isString() && newData.val().matches(/^(light|dark)$/)" },
        "viewport": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "ua": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "version": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "flags": {
          ".validate": "newData.hasChildren()",
          "$key": { ".validate": "$key.matches(/^[a-z-]{1,40}$/) && newData.isBoolean()" }
        },
        "image": { ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 350000" },
        "$other": { ".validate": false }
      }
    }
  }
}
